# Variabili SOLO per lo sviluppo locale dello stack Compose (fase 08).
# Valori fittizi e non segreti: NON usare in produzione. In Coolify i segreti
# reali si impostano nella UI, mai in un file committato.
#
#   docker compose --env-file infra/docker/dev.env \
#     -f docker-compose.yml -f docker-compose.dev.yml up --build

NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (dev)
POSTGRES_USER=businessbox
POSTGRES_PASSWORD=dev-password-change-me
POSTGRES_DB=businessbox

# Backend (dev) — segreti fittizi, lunghezza minima rispettata.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
ADMIN_API_KEY=dev-admin-key-change-me-please
ADMIN_DASHBOARD_USER=admin
ADMIN_DASHBOARD_PASSWORD=dev-admin-dashboard-password
CORS_ALLOWED_ORIGINS=

# OpenRouter opzionale in dev: se vuoto, l'AI resta disattivata.
OPENROUTER_API_KEY=

# MinIO (solo se usi il profilo `storage`)
MINIO_ROOT_USER=businessbox
MINIO_ROOT_PASSWORD=dev-minio-change-me
