# BusinessBox Browser — variabili d'ambiente di esempio.
# Copia in `.env` e compila. NON committare mai segreti reali.

NODE_ENV=development
LOG_LEVEL=info

# --- API (apps/api) ---
# Default sicuro: solo loopback. Usa 0.0.0.0 SOLO in container/produzione (fase 08).
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000

# --- Worker (apps/worker) ---
# Se assente, il worker termina in modo pulito (fase 00: Redis non ancora richiesto).
REDIS_URL=

# --- Database remoto (fase 06) ---
DATABASE_URL=

# --- Autenticazione (fase 06) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# --- OpenRouter / GLM 5.2 (fase 05) — SOLO server-side, mai nel desktop ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=BusinessBox Browser
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_PROVIDER_SORT=price
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
