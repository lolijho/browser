# BusinessBox Browser — variabili d'ambiente di esempio.
# Copia in `.env` e compila. NON committare mai segreti reali.

NODE_ENV=development
LOG_LEVEL=info

# --- API (apps/api) ---
# Default sicuro: solo loopback. Usa 0.0.0.0 SOLO in container/produzione (fase 08).
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000

# --- Worker (apps/worker) ---
# Se assente, il worker termina in modo pulito (fase 00: Redis non ancora richiesto).
REDIS_URL=
# Endpoint di liveness del worker (solo loopback del container, per healthcheck).
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002

# --- Database remoto (fase 06) ---
# Se assente, l'API usa un datastore IN-MEMORY (dev/alpha): i dati non
# sopravvivono al riavvio. In produzione è obbligatorio.
DATABASE_URL=

# --- Autenticazione / backend (fase 06) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Chiave della dashboard admin: se assente, le rotte /admin restano disattivate (503).
ADMIN_API_KEY=
# Origini CORS ammesse (vuoto = tutte, solo per sviluppo).
CORS_ALLOWED_ORIGINS=
# Dashboard admin (apps/admin) — chiave server-side, mai esposta al browser.
# ADMIN_API_KEY (sopra) è condivisa con l'app admin.

# --- OpenRouter / GLM 5.2 (fase 05) — SOLO server-side, mai nel desktop ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=BusinessBox Browser
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_PROVIDER_SORT=price
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true

# ===========================================================================
# Deploy Docker / Coolify (fase 08) — vedi docs/COOLIFY_DEPLOY.md
# ===========================================================================
# In Coolify questi valori si impostano come SECRET nella UI, mai nel repo.
# In locale usa infra/docker/dev.env (valori fittizi) con i file compose.

# PostgreSQL: il Compose costruisce DATABASE_URL da questi tre valori.
POSTGRES_USER=businessbox
POSTGRES_PASSWORD=
POSTGRES_DB=businessbox

# Domini pubblici (Coolify li assegna e li inietta):
#  - PUBLIC_API_URL: dominio dell'API, usato anche dalla dashboard admin.
#  - ADMIN_PUBLIC_URL: dominio della dashboard admin.
PUBLIC_API_URL=
ADMIN_PUBLIC_URL=

# NOTA sui segreti indicati dallo spec (prompt 08):
#  - JWT_REFRESH_SECRET / ENCRYPTION_KEY: NON usati dall'API attuale. I refresh
#    token sono ruotati e persistiti lato server (hash in DB), i segreti desktop
#    sono cifrati con `safeStorage` di Electron. Vengono aggiunti qui solo se in
#    futuro si introdurranno cifrature server-side dedicate.
# JWT_REFRESH_SECRET=
# ENCRYPTION_KEY=

# Observability opzionale.
SENTRY_DSN=

# Storage oggetti opzionale (profilo `storage` / MinIO).
MINIO_ROOT_USER=businessbox
MINIO_ROOT_PASSWORD=
